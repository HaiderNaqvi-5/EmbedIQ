# ==============================================================================
# EmbedIQ Environment Configuration Template
# ==============================================================================

# Application Environment (development, staging, production)
APP_ENV=development
APP_NAME=EmbedIQ
API_BASE_URL=http://localhost:8000
FRONTEND_ORIGIN=http://localhost:3000

# Server Host & Port
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

# PostgreSQL & pgvector Database Connection
# Format: postgresql+asyncpg://<user>:<password>@<host>:<port>/<dbname>
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5433/embediq_db
SYNC_DATABASE_URL=postgresql://postgres:postgres@localhost:5433/embediq_db

# Redis Connection (Celery Broker, Result Backend & Rate Limiting)
REDIS_URL=redis://localhost:6379/0

# Security & Authentication (JWT)
# Generate via: openssl rand -hex 32
JWT_SECRET=replace_with_a_secure_random_secret_minimum_32_characters
JWT_ALGORITHM=HS256
JWT_EXPIRES_MINUTES=1440

# AI & Embedding Providers
# Supported EMBEDDING_PROVIDER options: openai, local
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_API_KEY=your-openai-api-key-here
EMBEDDING_DIMENSION=1536

# Supported LLM_PROVIDER options: openai, anthropic, google
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=your-openai-api-key-here

# Crawler & Ingestion Operational Limits (PRD Section 11)
MAX_PAGES_PER_BOT=50
MAX_CRAWL_DEPTH=4
HTTP_TIMEOUT_SECONDS=15
BROWSER_NAV_TIMEOUT_SECONDS=30
MAX_RESPONSE_BYTES=5000000
MAX_REDIRECTS=5
CRAWL_CONCURRENCY_PER_BOT=5
HTTP_RETRIES=2
PLAYWRIGHT_RETRIES=1
EMBEDDING_RETRIES=3

# RAG & Chat Retrieval Limits
DEFAULT_TOP_K=5
MAX_TOP_K=10
MIN_SIMILARITY_THRESHOLD=0.65
TARGET_CHUNK_TOKENS=600
MAX_CHUNK_TOKENS=1000
CHUNK_OVERLAP_TOKENS=100
MAX_USER_MESSAGE_CHARS=4000
